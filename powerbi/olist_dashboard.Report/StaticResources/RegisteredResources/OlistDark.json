{
  "name": "Olist Dark",
  "dataColors": ["#22D3EE", "#A78BFA", "#F472B6", "#34D399", "#FBBF24", "#60A5FA", "#F87171", "#94A3B8"],
  "background": "#0B1020",
  "foreground": "#E2E8F0",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#22D3EE",
  "center": "#A78BFA",
  "minimum": "#1E293B",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#22D3EE" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#E2E8F0" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E2E8F0" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#94A3B8" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111933" } }, "transparency": 20 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#26335A" } }, "radius": 16 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#000000" } }, "position": "Outer", "preset": "Custom", "shadowSpread": 0, "shadowBlur": 24, "angle": 90, "shadowDistance": 6, "transparency": 55 }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E2E8F0" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "visualHeader": [{ "background": { "solid": { "color": "#111933" } }, "foreground": { "solid": { "color": "#94A3B8" } }, "border": { "solid": { "color": "#26335A" } }, "transparency": 0 }],
        "visualTooltip": [{ "background": { "solid": { "color": "#0F172A" } }, "titleFontColor": { "solid": { "color": "#94A3B8" } }, "valueFontColor": { "solid": { "color": "#F8FAFC" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "titleColor": { "solid": { "color": "#94A3B8" } }, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "titleColor": { "solid": { "color": "#94A3B8" } }, "showAxisTitle": false, "gridlineColor": { "solid": { "color": "#1E293B" } }, "gridlineStyle": "dotted" }],
        "legend": [{ "show": true, "position": "Top", "labelColor": { "solid": { "color": "#CBD5E1" } }, "fontSize": 10 }],
        "labels": [{ "color": { "solid": { "color": "#E2E8F0" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1020" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#070B16" } }, "transparency": 0 }]
      }
    },
    "filter": {
      "*": {
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#0F172A" } }, "foregroundColor": { "solid": { "color": "#E2E8F0" } }, "border": true, "borderColor": { "solid": { "color": "#26335A" } } }],
        "filterCard": [{ "$id": "Available", "backgroundColor": { "solid": { "color": "#111933" } }, "foregroundColor": { "solid": { "color": "#E2E8F0" } } }, { "$id": "Applied", "backgroundColor": { "solid": { "color": "#16224A" } }, "foregroundColor": { "solid": { "color": "#E2E8F0" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#22D3EE" } }, "fontSize": 30, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#94A3B8" } }, "fontSize": 11 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2B3B6B" } }, "radius": 18 }],
        "title": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#111933" } }, "transparency": 0 }],
        "items": [{ "fontColor": { "solid": { "color": "#E2E8F0" } }, "background": { "solid": { "color": "#111933" } }, "outlineColor": { "solid": { "color": "#26335A" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#94A3B8" } }, "outlineStyle": 0 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#22D3EE" } }, "backColor": { "solid": { "color": "#0F172A" } }, "outline": "None" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E2E8F0" } }, "backColorPrimary": { "solid": { "color": "#111933" } }, "fontColorSecondary": { "solid": { "color": "#E2E8F0" } }, "backColorSecondary": { "solid": { "color": "#0F172A" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#F8FAFC" } }, "backColor": { "solid": { "color": "#16224A" } } }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#1E293B" } }, "gridVertical": false, "outlineColor": { "solid": { "color": "#26335A" } } }]
      }
    },
    "treemap": {
      "*": {
        "labels": [{ "show": true, "color": { "solid": { "color": "#0B1020" } }, "fontSize": 12 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#0B1020" } }, "fontSize": 12 }]
      }
    }
  }
}
