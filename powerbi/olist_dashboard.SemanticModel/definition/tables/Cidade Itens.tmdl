/// Itens da Olist City 3D: cada linha é um número de um prédio (0 = etiqueta, 1–4 = KPIs do painel, 8–9 = insight)
table 'Cidade Itens'
	lineageTag: 437a2f63-72e8-48cf-a544-ac9a13bdae4f

	column predio
		dataType: string
		lineageTag: 0c3dcf9c-c271-4c59-8d4d-3f2dd3cacba9
		summarizeBy: none
		isNameInferred
		sourceColumn: [predio]

	column ordem
		dataType: int64
		formatString: 0
		lineageTag: c15a418f-b728-458f-9315-8113feb5a423
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordem]

	column item
