	/// Faixa de pontualidade da entrega (prefixo numérico garante a ordem no eixo)
	column faixa_entrega = SWITCH ( TRUE (), fact_orders[is_delivered] = FALSE (), "Não entregue", fact_orders[delay_days] <= -10, "10+ dias adiantado", fact_orders[delay_days] <= 0, "No prazo", fact_orders[delay_days] <= 5, "1–5 dias de atraso", fact_orders[delay_days] <= 15, "6–15 dias de atraso", "15+ dias de atraso" )
		dataType: string
		lineageTag: d482b6f5-97db-4240-8a2d-375ba1bd5191
		summarizeBy: none
		sortByColumn: faixa_entrega_ordem

	column forma_pagamento = SWITCH ( fact_orders[main_payment_type], "credit_card", "Cartão de crédito", "boleto", "Boleto", "voucher", "Voucher", "debit_card", "Cartão de débito", "Outros" )
		dataType: string
		lineageTag: 63b6490e-4cb6-43f8-81f6-976883af3b16
		summarizeBy: none

	column faixa_parcelas = SWITCH ( TRUE (), fact_orders[installments] <= 1, "À vista", fact_orders[installments] <= 3, "2–3x", fact_orders[installments] <= 6, "4–6x", fact_orders[installments] <= 10, "7–10x", "11x ou mais" )
		dataType: string
		lineageTag: 328c88fe-e3d6-473a-8ede-5337131c3a35
		summarizeBy: none
		sortByColumn: faixa_parcelas_ordem

	/// Ordem lógica de faixa_entrega (o rótulo não precisa de prefixo numérico)
	column faixa_entrega_ordem = SWITCH ( TRUE (), fact_orders[is_delivered] = FALSE (), 6, fact_orders[delay_days] <= -10, 1, fact_orders[delay_days] <= 0, 2, fact_orders[delay_days] <= 5, 3, fact_orders[delay_days] <= 15, 4, 5 )
		dataType: int64
		isHidden
		lineageTag: 77235f2f-4228-4405-ba67-72e6e2603e5f
		summarizeBy: none

	/// Ordem lógica de faixa_parcelas (o rótulo não precisa de prefixo numérico)
	column faixa_parcelas_ordem = SWITCH ( TRUE (), fact_orders[installments] <= 1, 1, fact_orders[installments] <= 3, 2, fact_orders[installments] <= 6, 3, fact_orders[installments] <= 10, 4, 5 )
		dataType: int64
		isHidden
		lineageTag: 09d93660-436b-4152-acab-d01bc138a9fe
		summarizeBy: none

	/// Pedido que conta como venda: exclui cancelados e indisponíveis (status final sem receita)
	column pedido_valido = NOT ( fact_orders[order_status] IN { "canceled", "unavailable" } )
		dataType: boolean
		lineageTag: c7fa6596-e502-4cf0-afb2-baf9ca45459c
		summarizeBy: none

