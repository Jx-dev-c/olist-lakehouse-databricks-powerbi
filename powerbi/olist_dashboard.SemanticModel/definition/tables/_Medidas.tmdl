	/// Minigráfico do Cartão KPI: valor de cada mês do período filtrado, separados por ";"
	measure 'Prazo Estimado (dias) Série' = CONCATENATEX ( ADDCOLUMNS ( SUMMARIZE ( ALLSELECTED ( dim_date ), dim_date[year_month] ), "@v", [Prazo Estimado (dias)] ), FORMAT ( [@v], "0.######", "en-US" ), ";", dim_date[year_month], ASC )
