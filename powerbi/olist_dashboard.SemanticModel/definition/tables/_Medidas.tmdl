	/// Minigráfico do Cartão KPI: valor de cada mês do período filtrado, separados por ";"
	measure 'Clientes Únicos Série' = CONCATENATEX ( ADDCOLUMNS ( SUMMARIZE ( ALLSELECTED ( dim_date ), dim_date[year_month] ), "@v", [Clientes Únicos] ), FORMAT ( [@v], "0.######", "en-US" ), ";", dim_date[year_month], ASC )
		displayFolder: 7. Séries (minigráficos)
