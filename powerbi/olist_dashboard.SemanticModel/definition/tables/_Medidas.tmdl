			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Comparativos
		lineageTag: 63a994ac-321d-4ef1-8131-7669203ff491

	/// Variação relativa do mês de referência contra o mesmo mês do ano anterior
	measure 'Pedidos vs Ano Anterior' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -12 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
