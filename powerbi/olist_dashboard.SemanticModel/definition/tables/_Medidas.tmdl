	/// Minigráfico do Cartão KPI: valor de cada mês do período filtrado, separados por ";"
	measure '% Recompra Série' = CONCATENATEX ( ADDCOLUMNS ( SUMMARIZE ( ALLSELECTED ( dim_date ), dim_date[year_month] ), "@v", [% Recompra] ), FORMAT ( [@v], "0.######", "en-US" ), ";", dim_date[year_month], ASC )
		displayFolder: 7. Séries (minigráficos)
		lineageTag: 528b3d47-323d-4dab-92b0-a8e82439c4f5

	/// Participação no total de pedidos do contexto (ex.: forma de pagamento)
	measure '% dos Pedidos' = DIVIDE ( [Pedidos], CALCULATE ( [Pedidos], REMOVEFILTERS ( fact_orders[forma_pagamento] ) ) )
		formatString: 0.0%
		displayFolder: 1. Vendas
		lineageTag: 248ba1b1-e304-4360-b880-33f09b370f46

	/// Período com vendas no contexto (cartões das páginas de análise)
	measure 'Período Selecionado' = FORMAT ( CALCULATE ( MIN ( dim_date[date] ), fact_order_items ), "mmm/yy" ) & "–" & FORMAT ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), "mmm/yy" )
		displayFolder: 6. Comparativos
		lineageTag: 62b002cb-506b-4116-ba5b-d96da9100ccb

	/// Valor no mês de referência (último mês com vendas no contexto)
	measure 'Receita Mês' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			RETURN CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
		formatString: "R$" #,0
		displayFolder: 6. Comparativos
		lineageTag: 18a8621c-440c-48bb-90ff-bb39b821c236

	/// Variação relativa do mês de referência contra o mês anterior
	measure 'Receita vs Mês Anterior' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Comparativos
		lineageTag: 75985f04-b7b0-4875-81c1-1ff7c3451c64

	/// Variação relativa do mês de referência contra o mesmo mês do ano anterior
	measure 'Receita vs Ano Anterior' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -12 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Comparativos
		lineageTag: 0232cf27-7acb-48c4-b7f8-0556d6ee7487

	/// Valor no mês de referência (último mês com vendas no contexto)
	measure 'Pedidos Mês' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			RETURN CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
		formatString: #,0
		displayFolder: 6. Comparativos
		lineageTag: f4109322-e993-4c61-bb99-3c053603e9ce

	/// Variação relativa do mês de referência contra o mês anterior
	measure 'Pedidos vs Mês Anterior' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
