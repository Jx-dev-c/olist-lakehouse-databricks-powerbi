/// Medidas do relatório. As duas fatos não se relacionam diretamente (evita ambiguidade com dim_date);
/// TREATAS leva o filtro de uma para a outra, então categoria/vendedor (itens) e pagamento/status (pedidos)
/// filtram todas as medidas.
table _Medidas

	/// Preço + frete dos itens. Responde a filtros de dimensões e de colunas de fact_orders.
	measure Receita = CALCULATE ( SUM ( fact_order_items[total_value] ), TREATAS ( VALUES ( fact_orders[order_id] ), fact_order_items[order_id] ) )
		formatString: "R$" #,0
		displayFolder: 1. Vendas

	measure 'Receita Produtos' = CALCULATE ( SUM ( fact_order_items[price] ), TREATAS ( VALUES ( fact_orders[order_id] ), fact_order_items[order_id] ) )
		formatString: "R$" #,0
		displayFolder: 1. Vendas

	measure Frete = CALCULATE ( SUM ( fact_order_items[freight_value] ), TREATAS ( VALUES ( fact_orders[order_id] ), fact_order_items[order_id] ) )
		formatString: "R$" #,0
		displayFolder: 1. Vendas

	measure 'Frete % da Receita' = DIVIDE ( [Frete], [Receita] )
		formatString: 0.0%
		displayFolder: 1. Vendas

	measure Pedidos = CALCULATE ( DISTINCTCOUNT ( fact_orders[order_id] ), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: #,0
		displayFolder: 1. Vendas

	measure 'Ticket Médio' = DIVIDE ( [Receita], [Pedidos] )
		formatString: "R$" #,0.00
		displayFolder: 1. Vendas

	measure 'Itens por Pedido' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_order_items ), TREATAS ( VALUES ( fact_orders[order_id] ), fact_order_items[order_id] ) ), [Pedidos] )
		formatString: 0.00
		displayFolder: 1. Vendas

	measure 'Clientes Únicos' = COUNTROWS ( SUMMARIZE ( CALCULATETABLE ( fact_order_items, TREATAS ( VALUES ( fact_orders[order_id] ), fact_order_items[order_id] ) ), dim_customer[customer_unique_id] ) )
		formatString: #,0
		displayFolder: 1. Vendas

	measure 'Vendedores Ativos' = DISTINCTCOUNT ( fact_order_items[seller_id] )
		formatString: #,0
		displayFolder: 2. Vendedores

	/// Curva de Pareto: receita acumulada dos vendedores com receita >= à do vendedor atual
	measure '% Receita Acumulada' =
			VAR atual = [Receita]
			VAR vendedores = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( fact_order_items[seller_id] ), "@receita", [Receita] ), REMOVEFILTERS ( dim_seller ) )
			VAR acumulado = SUMX ( FILTER ( vendedores, [@receita] >= atual ), [@receita] )
			RETURN DIVIDE ( acumulado, SUMX ( vendedores, [@receita] ) )
		formatString: 0%
		displayFolder: 2. Vendedores

	measure '% Receita Top 20% Vendedores' =
			VAR vendedores = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( fact_order_items[seller_id] ), "@receita", [Receita] ), REMOVEFILTERS ( dim_seller ) )
			VAR topo = TOPN ( ROUNDUP ( COUNTROWS ( vendedores ) * 0.2, 0 ), vendedores, [@receita], DESC )
			RETURN DIVIDE ( SUMX ( topo, [@receita] ), SUMX ( vendedores, [@receita] ) )
		formatString: 0.0%
		displayFolder: 2. Vendedores

	measure 'Pedidos Entregues' = CALCULATE ( [Pedidos], fact_orders[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: 3. Logística

	/// Entregue depois da data prometida ao cliente
	measure '% Atraso' = DIVIDE ( CALCULATE ( [Pedidos], fact_orders[is_late] = TRUE () ), [Pedidos Entregues] )
		formatString: 0.0%
		displayFolder: 3. Logística

	measure '% No Prazo' = 1 - [% Atraso]
		formatString: 0.0%
		displayFolder: 3. Logística

	measure 'Tempo Médio de Entrega (dias)' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = TRUE (), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: 0.0
		displayFolder: 3. Logística

	measure 'Prazo Estimado (dias)' = CALCULATE ( AVERAGE ( fact_orders[estimated_days] ), fact_orders[is_delivered] = TRUE (), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: 0.0
		displayFolder: 3. Logística

	measure 'Folga Média (dias)' = [Prazo Estimado (dias)] - [Tempo Médio de Entrega (dias)]
		formatString: 0.0
		displayFolder: 3. Logística

	measure 'Atraso Médio dos Atrasados (dias)' = CALCULATE ( AVERAGE ( fact_orders[delay_days] ), fact_orders[is_late] = TRUE (), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: 0.0
		displayFolder: 3. Logística

	measure Avaliações = CALCULATE ( COUNT ( fact_orders[review_score] ), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: #,0
		displayFolder: 4. Satisfação

	measure 'Nota Média' = CALCULATE ( AVERAGE ( fact_orders[review_score] ), TREATAS ( VALUES ( fact_order_items[order_id] ), fact_orders[order_id] ) )
		formatString: 0.00
		displayFolder: 4. Satisfação

	measure '% Avaliações Negativas' = DIVIDE ( CALCULATE ( [Avaliações], fact_orders[review_score] <= 2 ), [Avaliações] )
		formatString: 0.0%
		displayFolder: 4. Satisfação

	measure 'Nota Média - No Prazo' = CALCULATE ( [Nota Média], fact_orders[is_late] = FALSE () )
		formatString: 0.00
		displayFolder: 4. Satisfação

	measure 'Nota Média - Atrasados' = CALCULATE ( [Nota Média], fact_orders[is_late] = TRUE () )
		formatString: 0.00
		displayFolder: 4. Satisfação

	/// Clientes (customer_unique_id) com 2+ pedidos no contexto filtrado
	measure '% Recompra' =
			VAR clientes = ADDCOLUMNS ( SUMMARIZE ( fact_order_items, dim_customer[customer_unique_id] ), "@pedidos", CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ) ) )
			RETURN DIVIDE ( COUNTROWS ( FILTER ( clientes, [@pedidos] >= 2 ) ), COUNTROWS ( clientes ) )
		formatString: 0.0%
		displayFolder: 5. Clientes

	/// Segmentação RFM: retrato da base inteira, não responde ao filtro de período
	measure 'Clientes RFM' = COUNTROWS ( customer_rfm )
		formatString: #,0
		displayFolder: 5. Clientes

	measure 'Receita Clientes RFM' = SUM ( customer_rfm[monetary] )
		formatString: "R$" #,0
		displayFolder: 5. Clientes

	/// Último mês com vendas no contexto e o mês anterior a ele (base dos cards de variação)
	measure 'Mês de Referência' = FORMAT ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), "mmm/yy" )
		displayFolder: 6. Variação mensal

	measure 'Mês Anterior' = FORMAT ( EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), -1 ), "mmm/yy" )
		displayFolder: 6. Variação mensal

	measure 'Receita Δ%' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Receita], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Variação mensal

	measure 'Pedidos Δ%' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Pedidos], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Variação mensal

	measure 'Ticket Médio Δ%' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Ticket Médio], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Ticket Médio], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN DIVIDE ( atual - anterior, anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Variação mensal

	/// Nota: diferença absoluta em pontos (escala 1 a 5)
	measure 'Nota Média Δ' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [Nota Média], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [Nota Média], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN IF ( NOT ISBLANK ( anterior ), atual - anterior )
		formatString: +0.00;-0.00;0.00
		displayFolder: 6. Variação mensal

	/// % Atraso: diferença em pontos percentuais
	measure '% Atraso Δ' =
			VAR fim = EOMONTH ( CALCULATE ( MAX ( dim_date[date] ), fact_order_items ), 0 )
			VAR atual = CALCULATE ( [% Atraso], DATESINPERIOD ( dim_date[date], fim, -1, MONTH ) )
			VAR anterior = CALCULATE ( [% Atraso], DATESINPERIOD ( dim_date[date], EOMONTH ( fim, -1 ), -1, MONTH ) )
			RETURN IF ( NOT ISBLANK ( anterior ), atual - anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 6. Variação mensal

	measure 'Receita Δ Texto' =
			VAR d = [Receita Δ%]
			RETURN IF ( NOT ISBLANK ( d ), IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & "  vs " & [Mês Anterior] )
		displayFolder: 6. Variação mensal

	measure 'Pedidos Δ Texto' =
			VAR d = [Pedidos Δ%]
			RETURN IF ( NOT ISBLANK ( d ), IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & "  vs " & [Mês Anterior] )
		displayFolder: 6. Variação mensal

	measure 'Ticket Médio Δ Texto' =
			VAR d = [Ticket Médio Δ%]
			RETURN IF ( NOT ISBLANK ( d ), IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.0%" ) & "  vs " & [Mês Anterior] )
		displayFolder: 6. Variação mensal

	measure 'Nota Média Δ Texto' =
			VAR d = [Nota Média Δ]
			RETURN IF ( NOT ISBLANK ( d ), IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ), "0.00" ) & " pts  vs " & [Mês Anterior] )
		displayFolder: 6. Variação mensal

	measure '% Atraso Δ Texto' =
			VAR d = [% Atraso Δ]
			RETURN IF ( NOT ISBLANK ( d ), IF ( d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d ) * 100, "0.0" ) & " p.p.  vs " & [Mês Anterior] )
		displayFolder: 6. Variação mensal

	measure 'Receita Δ Cor' = IF ( [Receita Δ%] >= 0, "#10B981", "#EF4444" )
		displayFolder: 6. Variação mensal

	measure 'Pedidos Δ Cor' = IF ( [Pedidos Δ%] >= 0, "#10B981", "#EF4444" )
		displayFolder: 6. Variação mensal

	measure 'Ticket Médio Δ Cor' = IF ( [Ticket Médio Δ%] >= 0, "#10B981", "#EF4444" )
		displayFolder: 6. Variação mensal

	measure 'Nota Média Δ Cor' = IF ( [Nota Média Δ] >= 0, "#10B981", "#EF4444" )
		displayFolder: 6. Variação mensal

	/// Para atraso, subir é ruim: a cor é invertida
	measure '% Atraso Δ Cor' = IF ( [% Atraso Δ] <= 0, "#10B981", "#EF4444" )
		displayFolder: 6. Variação mensal

	column Coluna
		dataType: string
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Coluna]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "Coluna", "" )

