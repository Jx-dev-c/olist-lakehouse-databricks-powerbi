model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_orders","dim_customer","dim_seller","dim_product","dim_date","customer_rfm","agg_atraso_vs_avaliacao","fact_order_items"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_orders
ref table dim_customer
ref table dim_seller
ref table dim_product
ref table dim_date
ref table customer_rfm
ref table agg_atraso_vs_avaliacao
ref table fact_order_items
ref table _Medidas

ref cultureInfo pt-BR

